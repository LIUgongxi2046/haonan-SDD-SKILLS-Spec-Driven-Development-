{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline", "commitments", "acceptances", "tasks", "evidence", "continuation"],
  "properties": {
    "schema_version": {"const": 1},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "environment_ref"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "environment_ref": {"$ref": "#/$defs/text"}}
    },
    "commitments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commitment"}},
    "acceptances": {"type": "array", "items": {"$ref": "#/$defs/acceptance"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "continuation": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "remaining_task_ids", "next_task_id", "constraints", "authorization_refs"],
      "properties": {
        "mode": {"enum": ["PLAN", "SINGLE_TASK", "AUTHORIZED_BACKLOG", "PAUSED"]},
        "remaining_task_ids": {"$ref": "#/$defs/ids"},
        "next_task_id": {"type": ["string", "null"], "minLength": 1},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "authorization_refs": {"$ref": "#/$defs/ids"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "kind": {"enum": ["STRUCTURE", "STATIC", "UNIT", "API", "SECURITY", "BUSINESS", "INTEGRATION", "EXTERNAL", "EVAL", "VISUAL"]},
    "commitment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_ref", "outcome", "disposition", "acceptance_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "source_ref": {"$ref": "#/$defs/text"},
        "outcome": {"$ref": "#/$defs/text"}, "disposition": {"enum": ["IN_SCOPE", "EXCLUDED"]},
        "acceptance_ids": {"$ref": "#/$defs/ids"}, "decision_ref": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "IN_SCOPE"}}}, "then": {"properties": {"acceptance_ids": {"minItems": 1}}}},
        {"if": {"properties": {"disposition": {"const": "EXCLUDED"}}}, "then": {"required": ["decision_ref"], "properties": {"acceptance_ids": {"maxItems": 0}}}}
      ]
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/kind"}}
    },
    "consumer": {
      "type": "object", "additionalProperties": false, "required": ["required", "description"],
      "properties": {"required": {"type": "boolean"}, "description": {"$ref": "#/$defs/text"}, "check_id": {"$ref": "#/$defs/text"}},
      "allOf": [{"if": {"properties": {"required": {"const": true}}}, "then": {"required": ["check_id"]}}]
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "commitment_id", "scenario", "expected_result", "outcome_type", "capability", "required_checks", "status", "evidence_ids", "consumer"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "commitment_id": {"$ref": "#/$defs/text"},
        "scenario": {"$ref": "#/$defs/text"}, "expected_result": {"$ref": "#/$defs/text"},
        "outcome_type": {"enum": ["BUSINESS", "DESIGN", "QUALITY", "EXTERNAL"]},
        "capability": {"enum": ["REAL", "READONLY", "SIMULATION", "PROTOTYPE", "DESIGN"]},
        "required_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "STALE", "BLOCKED"]},
        "evidence_ids": {"$ref": "#/$defs/ids"}, "consumer": {"$ref": "#/$defs/consumer"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "acceptance_ids", "depends_on", "state", "allowed_paths", "blockers"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "acceptance_ids": {"$ref": "#/$defs/ids", "minItems": 1},
        "depends_on": {"$ref": "#/$defs/ids"},
        "state": {"enum": ["TODO", "IN_PROGRESS", "IMPLEMENTED", "ACCEPTED", "BLOCKED"]},
        "allowed_paths": {"$ref": "#/$defs/ids"}, "blockers": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      },
      "allOf": [{"if": {"properties": {"state": {"const": "BLOCKED"}}}, "then": {"properties": {"blockers": {"minItems": 1}}}}]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "check_id", "kind", "baseline_id", "receipt_path", "receipt_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "check_id": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/kind"},
        "baseline_id": {"$ref": "#/$defs/text"}, "receipt_path": {"$ref": "#/$defs/text"},
        "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
